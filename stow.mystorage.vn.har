            "text": "data: {\"type\":\"message-metadata\",\"messageMetadata\":{\"createdAt\":\"2026-09-19T09:15:47.265Z\"}}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"Dạ em đã ghi n\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"hận đầy đủ thông tin của anh Phúc:\\n\\n- **Họ tên**: Nguyễn Phúc\\n- **Số điện thoại*\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"*: 0854102215\\n- **Email**: phucnt2105@gmail.com\\n- **Địa chỉ lấy đồ**: 1258 Quang \"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"Trung, Phường Thông Tây Hội, Gò Vấp\\n- **Gói dịch vụ**: Kho trọn gói (Valet Storag\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"e) **3 m³** trong **3 tháng**\\n- **Đồ đạc lưu trữ**: 10–12 thùng đồ, 1 bàn làm việ\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"c nhỏ nguyên khối và 2–3 vali\\n\\nĐội ngũ kinh doanh của MyStorage đã nhận được thôn\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"g tin và sẽ đo khoảng cách chính xác từ chi nhánh 375 Võ Nguyên Giáp để gửi bảng \"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"báo giá chi tiết (bao gồm tiền thuê kho và cước phí lấy đồ) qua Zalo/email cho an\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"h trong thời gian sớm nhất ạ.\\n\\nAnh Phúc dự kiến muốn bên em qua lấy đồ vào **ng\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"ày nào** và tr\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"ong **khung giờ nào** để đội xe tiện sắp xếp lịch trước cho anh nhé?\\n\\n\"}\n\ndata: [DONE]\n\n"
          },
