            "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg id=\"Layer_1\" xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" viewBox=\"0 0 595.28 595.28\">\n  <!-- Generator: Adobe Illustrator 30.3.0, SVG Export Plug-In . SVG Version: 2.1.3 Build 182)  -->\n  <defs>\n    <style>\n      .st0 {\n        fill: #0275bd;\n      }\n    </style>\n  </defs>\n  <g>\n    <path class=\"st0\" d=\"M240.37,510.12c-24.15,0-47.29-11.35-62-30.89l-88.2-117.13c-16.61-22.06-20.22-51.55-9.42-76.96l57.34-134.95c10.8-25.41,34.53-43.28,61.94-46.64l145.54-17.82c27.41-3.36,54.75,8.26,71.36,30.32l88.2,117.13c16.61,22.06,20.22,51.55,9.42,76.96l-57.34,134.95c-10.8,25.41-34.53,43.28-61.94,46.64l-145.54,17.82c-3.12.38-6.25.57-9.35.57ZM354.95,133.57c-1.17,0-2.34.07-3.51.21l-145.54,17.82c-10.29,1.26-19.21,7.97-23.26,17.52l-57.34,134.95c-4.06,9.54-2.7,20.62,3.54,28.9l88.2,117.13c6.24,8.28,16.51,12.65,26.8,11.39l145.54-17.82c10.29-1.26,19.21-7.97,23.26-17.52l57.34-134.95c4.06-9.54,2.7-20.62-3.54-28.9l-88.2-117.13c-5.53-7.34-14.22-11.6-23.29-11.6Z\"/>\n    <path class=\"st0\" d=\"M297.7,298.16l-.13-1.04.36-.04.13,1.04-.36.04ZM310.6,296.58l-.13-1.04,12.54-1.54.13,1.04-12.54,1.54ZM335.67,293.51l-.13-1.04,12.54-1.53.13,1.04-12.54,1.53ZM360.74,290.44l-.13-1.04,12.54-1.53.13,1.04-12.54,1.53ZM385.81,287.37l-.13-1.04,12.54-1.53.13,1.04-12.54,1.53ZM410.89,284.3l-.13-1.04,12.54-1.53.13,1.04-12.54,1.53ZM435.96,281.23l-.13-1.04,12.54-1.53.13,1.04-12.54,1.53ZM461.03,278.16l-.13-1.04,12.54-1.53.13,1.04-12.54,1.53Z\"/>\n    <path class=\"st0\" d=\"M297.21,297.95l-.25-.34.85-.62.25.34-.85.62ZM289.47,287.44l-7.49-10.17.85-.62,7.49,10.17-.85.62ZM274.5,267.1l-7.49-10.17.85-.62,7.49,10.17-.85.62ZM259.52,246.76l-7.49-10.17.85-.62,7.49,10.17-.85.62ZM244.54,226.42l-7.49-10.17.85-.62,7.49,10.17-.85.62ZM229.57,206.08l-7.49-10.17.85-.62,7.49,10.17-.85.62ZM214.59,185.74l-7.49-10.17.85-.62,7.49,10.17-.85.62ZM199.61,165.4l-7.49-10.17.85-.62,7.49,10.17-.85.62Z\"/>\n    <path class=\"st0\" d=\"M237.09,463.1l-.99-.36,4