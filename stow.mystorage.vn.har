          "content": {
            "size": 2702,
            "mimeType": "text/event-stream",
            "text": "data: {\"type\":\"message-metadata\",\"messageMetadata\":{\"createdAt\":\"2026-09-19T09:05:38.460Z\"}}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"Dạ số tiền **3.\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"102.000 VNĐ** là chi phí thuê kho lưu trữ trong 3 tháng (đã gồm 8% VAT), **chưa\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\" bao gồm** phí lấy đồ và phí giao đồ sau này ạ. Đây là các dịch vụ vận chuyển riê\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"ng biệt.\\n\\nChi tiết về cách tính các khoản phí này như sau:\\n\\n### 1. Phí lấy đồ\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\" ban đầu (Pickup)\\n* **Cách tính tiêu chuẩn**: **20.000 VNĐ/km** (khoảng cá\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"ch di chuyển từ 375 Võ Nguyên Giáp, TP. Thủ Đức đến địa chỉ của anh/chị) + **195\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\".000 VNĐ/m³** phí bốc xếp (sàn tối thiểu 350.000 VNĐ/chuyến).\\n* Với khối lượng \"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"**3 m³** của anh/chị, phần phí bốc dỡ là **585.000 VNĐ** (+ phí khoảng cách km \"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"thực tế).\\n* *Lưu ý*: Mức giá tiêu chuẩn áp dụng cho chung cư có thang máy/nhà t\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"rệt, chưa bao gồm các phụ phí bọc lót đồ gỗ chuyên dụng, khiêng vác thang bộ\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\" nhiều lầu hoặc bốc dỡ ngoài giờ hành chính nếu có.\\n* Do cần đo khoảng cách chí\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"nh xác trên bản đồ, hệ thống cần biết địa chỉ cụ thể mới có thể báo con số c\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"hính xác nhất cho anh/chị.\\n\\n---\\n\\n### 2. Phí giao trả đồ sau này (Delivery)\\n* Kho\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"ản phí này **không thu trước**.\\n* Sau này khi hết hạn thuê hoặc khi anh/chị cần n\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"hận lại đồ, anh/chị chỉ cần cung cấp thời gian, địa chỉ nhận và ghi chú thực tế\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\". Đội ngũ vận hành sẽ kiểm tra lịch xe, lộ trình và gửi báo giá chính xác cho \"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"anh/chị xác nhận trước khi tiến hành giao hàng.\\n\\nAnh/chị có thể chia sẻ trước \"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\"**địa chỉ hoặc khu vực lấy đồ** (tên đường, phường, quận) để em tính toán\"}\n\ndata: {\"type\":\"text-delta\",\"delta\":\" cự ly và gửi mức phí lấy đồ chính xác cho mình tham khảo trước nhé?\\n\\n\"}\n\ndata: [DONE]\n\n"
          },
